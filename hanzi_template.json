{
  "qfmt": "<div id=\"translation\">{{Translation}}</div><div id=\"target-quiz\"></div><script type=\"text/javascript\">var characters = \"{{Hanzi}}\".split(\"\");var js = document.createElement(\"script\");js.type = \"text/javascript\";js.src = \"https://cdn.jsdelivr.net/npm/hanzi-writer@__HANZI_WRITER_VERSION__/dist/hanzi-writer.min.js\";js.onload = function() {for (let x of characters) {var characterContainer = document.createElement('div');characterContainer.style.display = 'inline-block';characterContainer.style.border = '2px solid black';characterContainer.style.margin = '2px';var writer = HanziWriter.create(characterContainer, x, {width: __CHARACTER_WIDTH__,height: __CHARACTER_HEIGHT__,showCharacter: false,showOutline: false,showHintAfterMisses: 1,highlightOnComplete: false,padding: 5});writer.quiz({onMistake: function() { console.log(\"Mistake!\"); },onComplete: function() { console.log(\"Completed!\"); }});document.getElementById('target-quiz').appendChild(characterContainer);}};document.body.appendChild(js);</script>",
  
  "afmt": "<div id=\"word\">{{Translation}} - {{Hanzi}} {{Pinyin}} <br>{{Mp3}}<br></div><hr id=\"answer\"><div id=\"target-animation\"></div><script type=\"text/javascript\">var characters = \"{{Hanzi}}\".split(\"\");var js = document.createElement(\"script\");js.type = \"text/javascript\";js.src = \"https://cdn.jsdelivr.net/npm/hanzi-writer@__HANZI_WRITER_VERSION__/dist/hanzi-writer.min.js\";js.onload = function() {for (let x of characters) {var writer = HanziWriter.create('target-animation', x, {width: 70,height: 70,padding: 5,showOutline: true,strokeAnimationSpeed: __STROKE_ANIMATION_SPEED__,delayBetweenStrokes: __DELAY_BETWEEN_STROKES__,radicalColor: '#337ab7'});writer.loopCharacterAnimation();}};document.body.appendChild(js);</script>"
