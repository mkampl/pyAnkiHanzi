  "qfmt": "<style>body{margin:0;padding:20px;background:#f5f7fa;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif}.flashcard{max-width:600px;margin:0 auto;background:white;border-radius:20px;box-shadow:0 10px 30px rgba(0,0,0,0.1);overflow:hidden}.header{background:linear-gradient(45deg,#667eea,#764ba2);color:white;padding:25px;text-align:center}.translation{font-size:24px;font-weight:300;margin:0}.subtitle{font-size:14px;opacity:0.8;margin-top:8px}.content{padding:30px}#target-quiz{text-align:center}.char-box{display:inline-block;margin:10px;background:#f8f9fa;border:2px dashed #dee2e6;border-radius:12px;padding:15px;transition:all 0.3s ease}.char-box:hover{border-color:#667eea;box-shadow:0 5px 15px rgba(102,126,234,0.2)}.instructions{text-align:center;color:#6c757d;margin-bottom:25px;font-size:16px}</style><div class='flashcard'><div class='header'><div class='translation'>{{Translation}}</div><div class='subtitle'>Practice writing the characters</div></div><div class='content'><div class='instructions'>✏️ Trace each character following the stroke order</div><div id='target-quiz'></div></div></div><script>var chars='{{Hanzi}}'.split('');var script=document.createElement('script');script.src='https://cdn.jsdelivr.net/npm/hanzi-writer@__HANZI_WRITER_VERSION__/dist/hanzi-writer.min.js';script.onload=function(){chars.forEach(function(char){var box=document.createElement('div');box.className='char-box';var writer=HanziWriter.create(box,char,{width:__CHARACTER_WIDTH__,height:__CHARACTER_HEIGHT__,showCharacter:false,showOutline:true,showHintAfterMisses:2,highlightOnComplete:true,highlightCompleteColor:'#28a745',padding:8,strokeColor:'#667eea',radicalColor:'#e74c3c',outlineColor:'#dee2e6'});writer.quiz({onComplete:function(){box.style.background='#d4edda';box.style.borderColor='#28a745'}});document.getElementById('target-quiz').appendChild(box)})};document.body.appendChild(script);</script>",
  
  "afmt": "<style>body{margin:0;padding:20px;background:#f5f7fa;font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif}.flashcard{max-width:600px;margin:0 auto;background:white;border-radius:20px;box-shadow:0 10px 30px rgba(0,0,0,0.1);overflow:hidden}.header{background:linear-gradient(45deg,#28a745,#20c997);color:white;padding:25px;text-align:center}.word-info{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap}.translation{font-size:20px;font-weight:300}.hanzi{font-size:42px;font-weight:bold;text-shadow:2px 2px 4px rgba(0,0,0,0.1)}.pinyin{font-size:18px;font-style:italic;opacity:0.9}.content{padding:30px;text-align:center}.audio-section{margin:20px 0;padding:15px;background:#f8f9fa;border-radius:10px}.animation-container{background:#f8f9fa;border-radius:15px;padding:25px;margin-top:20px}.animation-title{color:#495057;margin-bottom:20px;font-size:18px;font-weight:500}</style><div class='flashcard'><div class='header'><div class='word-info'><div><div class='translation'>{{Translation}}</div><div class='pinyin'>{{Pinyin}}</div></div><div class='hanzi'>{{Hanzi}}</div></div></div><div class='content'><div class='audio-section'>🔊 {{Mp3}}</div><div class='animation-container'><div class='animation-title'>📝 Stroke Order Demonstration</div><div id='target-animation'></div></div></div></div><script>var chars='{{Hanzi}}'.split('');var script=document.createElement('script');script.src='https://cdn.jsdelivr.net/npm/hanzi-writer@__HANZI_WRITER_VERSION__/dist/hanzi-writer.min.js';script.onload=function(){chars.forEach(function(char,i){setTimeout(function(){var writer=HanziWriter.create('target-animation',char,{width:85,height:85,padding:8,showOutline:true,strokeAnimationSpeed:__STROKE_ANIMATION_SPEED__,delayBetweenStrokes:__DELAY_BETWEEN_STROKES__,strokeColor:'#28a745',radicalColor:'#e74c3c',outlineColor:'#ced4da'});writer.animateCharacter()},i*2000)})};document.body.appendChild(script);</script>"
